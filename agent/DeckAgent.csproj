<Project Sdk="Microsoft.NET.Sdk">

  <!-- The PC side of 「PC に指示を出す」: a tray program that holds one SSE
       stream open to the board, opens each sealed instruction with the board's
       key, carries it out, and reports only ok / not ok. Everything readable
       about an instruction exists on this machine and in the browser that
       sealed it; the server between them holds ciphertext. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <AssemblyName>DeckAgent</AssemblyName>
    <RootNamespace>DeckAgent</RootNamespace>
    <Product>Multitasker PC Agent</Product>
    <AssemblyTitle>Multitasker PC Agent</AssemblyTitle>
    <Company>Max EV Gathering</Company>
    <Version>0.3.2</Version>

    <!-- Published as one self-contained exe (build.ps1). Native pieces are
         unpacked at first run rather than looked up beside the exe, so the
         installer ships a single file and the exe also runs from anywhere. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No NuGet: HKDF, AES-GCM, SHA-256 and the WebSocket client are all in
         the base library. -->
    <RestoreUseStaticGraphEvaluation>false</RestoreUseStaticGraphEvaluation>
  </PropertyGroup>

</Project>
